rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each person can read and write their own record (users/{their id}) and the finished
    // tests under it, and nothing else.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // The leaderboard: one public entry per person, holding only a nickname, an avatar and two
    // counts. Anyone may read it; each person may write or remove only their own entry, and
    // only in this exact shape.
    match /leaderboard/{uid} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'avatar', 'answered', 'correct', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.avatar is string && request.resource.data.avatar.size() <= 16
        && request.resource.data.answered is int
        && request.resource.data.answered >= 0 && request.resource.data.answered <= 100000
        && request.resource.data.correct is int
        && request.resource.data.correct >= 0 && request.resource.data.correct <= request.resource.data.answered
        && request.resource.data.updatedAt is string;
    }
  }
}
