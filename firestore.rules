rules_version = '2';

// Each person can read and write their own record (users/{their id}) and the finished tests
// under it, and nothing else. Anyone not signed in can't touch the database at all.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
